DATABASE_URL=postgresql+asyncpg://hrms:hrms_dev_pass@localhost:5433/hrms_db
JWT_SECRET_KEY=change-me-in-real-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_HOST=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Seed demo team (1 admin, 1 HR, 6 employees + sample data) on bootstrap.
SEED_DEMO_DATA=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=

# Day 14: backend-only RAG configuration. Set your real key in the root .env.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2

# Day 15: grounded policy question answering.
RAG_GENERATION_MODEL=gemini-3.5-flash-lite
RAG_TOP_K=7
RAG_MAX_COSINE_DISTANCE=0.45
RAG_GENERATION_TIMEOUT_SECONDS=30
RAG_GENERATION_MAX_RETRIES=2
